# ============================================
# Dataflux 环境变量配置
# ============================================
# 复制此文件为 .env 后修改：cp .env.example .env
# 开发环境最小配置: 填写 DATABASE_URL + REDIS_URL + SECRET_KEY 即可启动
# ============================================

# ---- 运行模式 ----
ENV=development
# production 模式不会自动建表, 需要使用 Alembic 迁移

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dataflux
COLLECTED_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/dataflux_collected
DB_SCHEMA=public

# ---- 数据库连接池(可选, 生产环境建议加大)----
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# ---- 服务配置 ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8028
LOG_LEVEL=info
TIMEZONE=Asia/Shanghai

# ---- 安全 ----
# 生产环境请务必替换为长随机字符串!
SECRET_KEY=your-secret-key-please-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 功能开关 ----
ENABLE_DB_CHECK=False     # 启动时严格校验数据库连接(失败则退出)
ENABLE_ENCRYPT=False      # AES 加密 API 响应体
ENABLE_TOKEN=False        # 启用 JWT 登录验证(生产环境建议打开)
ENABLE_LICENSE=False      # 启用 license.key 许可验证(生产环境建议打开)

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MongoDB(可选, 仅 MongoDB 采集任务需要)----
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=dataflux
MONGO_BATCH_SIZE=100

# ---- InfluxDB(可选, 仅 Kafka/MQTT/API 等监控功能需要)----
INFLUX_URL=http://localhost:8181
INFLUX_TOKEN=your-influxdb-token
INFLUX_DB=testdb

# ---- 文件系统 ----
FTP_LOCAL_SAVE_DIR=ftp_files

# ---- 批处理 ----
BATCH_SIZE=10

# ---- Whisper ASR(可选, 仅音视频转写需要)----
# WHISPER_MODEL_PATH=./large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
