ENV=development

# ========== 数据库 ============
DATABASE_URL=postgresql+psycopg2://postgres:654321@host.docker.internal:5432/dataflux
COLLECTED_DATABASE_URL=postgresql+psycopg2://postgres:654321@host.docker.internal:5432/dataflux_collected
DB_SCHEMA=public

# ========== 安全 ============
SECRET_KEY=abc123xyz456def789ghi012jkl345mno678pqr901stu234vwx567yz
ALGORITHM=HS256
ENABLE_DB_CHECK=False
ENABLE_ENCRYPT=False
ENABLE_TOKEN=True
ENABLE_LICENSE=True
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========== Redis ============
REDIS_URL=redis://host.docker.internal:6379/8

# ========== MongoDB ============
MONGO_URL=mongodb://host.docker.internal:27017
MONGO_DB_NAME=dataflux
MONGO_BATCH_SIZE=100

# ========== 服务配置 ============
SERVER_HOST=0.0.0.0
SERVER_PORT=8028
LOG_LEVEL=info
TIMEZONE=Asia/Shanghai

# ========== InfluxDB ============
INFLUX_URL=http://host.docker.internal:8181
INFLUX_TOKEN=apiv3_QFChw4KEwrJPBr_VA2U1Kc0HLCCFVimOoPK9d_PcVJ9SG9_5pq06l-mx-dpXcaCAdW8u4XL45pNsezO2ybzjlg
INFLUX_DB=testdb

# ========== 文件系统 ============
FTP_LOCAL_SAVE_DIR=ftp_files

# ========== 批处理 ============
BATCH_SIZE=10

# ========== 数据库连接池 ============
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True

# ========== Whisper ASR ============
WHISPER_MODEL_PATH=/app/large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16